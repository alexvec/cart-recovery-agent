# Copy to .env (git-ignored). Never commit real values.

# Shopify app (from `shopify app info` / Partner Dashboard)
SHOPIFY_API_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Shared secret the ElevenLabs server tools send in the X-Tool-Secret header
TOOL_SECRET=

# PII protection: Fernet key for phone numbers at rest, HMAC key for phone hashes.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
PHONE_HASH_KEY=

# fake = log calls and simulate outcomes locally
# browser = the call rings on http://localhost:8090/phone and runs over your mic (no telephony cost)
# elevenlabs = real outbound calls via Twilio
DIALER=fake

# Minutes to wait after the last checkout update before calling
CALL_DELAY_MINUTES=20
